{
  "name": "@tft/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Electron desktop shell for the TFT soundtrack companion",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "smoke": "electron-vite build && electron . --smoke-test",
    "smoke:capture": "electron-vite build && electron . --capture-smoke-test",
    "smoke:recognition": "electron-vite build && electron . --recognition-smoke-test",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@tft/shared-types": "workspace:*",
    "pinia": "^4.1.0",
    "vue": "^3.5.45",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.11",
    "electron": "^45.3.2",
    "electron-vite": "^6.0.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  }
}
